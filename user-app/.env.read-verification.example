# Read verification env flags — copy into `.env.local` for manual QA
# Full step-by-step: ../docs/mobile-read-verification-results.md

# Count and log every Appwrite list/get; exposes window.__priceMateReadStats
VITE_READ_DEBUG=true

# Opt-in dev diagnostics burst (disabled automatically when VITE_READ_DEBUG=true)
# VITE_RUN_DIAGNOSTICS=true

# Then:
#   cd PriceMate/user-app && npm run dev
#   Open DevTools Console → __priceMateReadStats.reset() before each scenario
